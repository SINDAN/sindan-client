#!/bin/sh
# version 1.0.0

INTERACTIVE=True
CONFIG=./sindan.conf

# Print the value of KEY in the configuration file, or nothing if the file
# has no such line. A line may start with "readonly " as in sindan.conf.example.
# (based on the function of raspi-config)
get_config_var() {
  lua - "$1" "$2" <<'EOF'
local key=assert(arg[1])
local fn=assert(arg[2])
local file=assert(io.open(fn))
for line in file:lines() do
  local body = (line:gsub("^%s*readonly%s+", ""))
  local val = body:match("^%s*"..key.."=(.*)$")
  if (val ~= nil) then
    print(val)
    break
  end
end
EOF
}

# Set KEY to VALUE in the configuration file: replace the line of KEY (also a
# commented out one) and keep its "readonly " prefix, or append a new line.
# The file is replaced only if the rewrite succeeded.
# (based on the function of raspi-config)
# set_config_var <key> <value> <file>
set_config_var() {
  if lua - "$1" "$2" "$3" > "$3.bak" <<'EOF'
local key=assert(arg[1])
local value=assert(arg[2])
local fn=assert(arg[3])
local file=assert(io.open(fn))
local made_change=false
for line in file:lines() do
  local body = (line:gsub("^#?%s*", ""))
  local readonly = body:match("^readonly%s+") ~= nil
  body = (body:gsub("^readonly%s+", ""))
  if body:match("^"..key.."=") then
    line=(readonly and "readonly " or "")..key.."="..value
    made_change=true
  end
  print(line)
end

if not made_change then
  print(key.."="..value)
end
EOF
  then
    # cat keeps the permissions of the configuration file.
    cat "$3.bak" > "$3" && rm -f "$3.bak"
  else
    rm -f "$3.bak"
    echo "ERROR: cannot update $3." 1>&2
    return 1
  fi
}

# use function from raspi-config
calc_wt_size() {
  # NOTE: it's tempting to redirect stderr to /dev/null, so suppress error 
  # output from tput. However in this case, tput detects neither stdout or 
  # stderr is a tty and so only gives default 80, 24 values
  WT_HEIGHT=17
  WT_WIDTH=$(tput cols)

  if [ -z "$WT_WIDTH" ] || [ "$WT_WIDTH" -lt 60 ]; then
    WT_WIDTH=80
  fi
  if [ "$WT_WIDTH" -gt 178 ]; then
    WT_WIDTH=120
  fi
  WT_MENU_HEIGHT=$((WT_HEIGHT - 7))
}

do_select_mode() {
  if [ "${INTERACTIVE}" = True ]; then
    MODE=$(whiptail --menu "Choose the measurement mode" 20 60 10 \
      "1" "probe: a fixed measurement point (also pings the routers)" \
      "2" "client: an end user device (also checks the path MTU)" \
      3>&1 1>&2 2>&3)
    RET=$?
  else
    MODE=$1
    RET=0
  fi
  if [ "${RET}" -eq 1 ]; then
    return 0
  elif [ "${RET}" -eq 0 ]; then
    if [ "${MODE}" -eq 1 ]; then
      set_config_var MODE probe "${CONFIG}"
      STATUS=probe
    elif [ "${MODE}" -eq 2 ]; then
      set_config_var MODE client "${CONFIG}"
      STATUS=client
    fi
  fi
  if [ "${INTERACTIVE}" = True ]; then
    whiptail --msgbox "The setting of measurement mode is ${STATUS}" 20 60 1
  fi
}

do_reconnect() {
  DEFAULT=--defaultno
  if [ "${INTERACTIVE}" = True ]; then
    whiptail --yesno "Would you like to reconnect the interface for each measurement?" ${DEFAULT} 20 60 2
    RET=$?
  else
    RET=$1
  fi
  if [ "${RET}" -eq 0 ]; then
    set_config_var RECONNECT yes "${CONFIG}"
    STATUS=yes
  elif [ "${RET}" -eq 1 ]; then
    set_config_var RECONNECT no "${CONFIG}"
    STATUS=no
  else
    return "${RET}"
  fi
  if [ "${INTERACTIVE}" = True ]; then
    whiptail --msgbox "The reconnect setting is ${STATUS}" 20 60 1
  fi
}

do_verbose() {
  DEFAULT=--defaultno
  if [ "${INTERACTIVE}" = True ]; then
    whiptail --yesno "Would you like to use verbose mode?" ${DEFAULT} 20 60 2
    RET=$?
  else
    RET=$1
  fi
  if [ "${RET}" -eq 0 ]; then
    set_config_var VERBOSE yes "${CONFIG}"
    STATUS=yes
  elif [ "${RET}" -eq 1 ]; then
    set_config_var VERBOSE no "${CONFIG}"
    STATUS=no
  else
    return "${RET}"
  fi
  if [ "${INTERACTIVE}" = True ]; then
    whiptail --msgbox "The verbose setting is ${STATUS}" 20 60 1
  fi
}

do_set_retry() {
  CURRENT=$(get_config_var MAX_RETRY "${CONFIG}")
  CURRENT=${CURRENT:-10}
  if [ "${INTERACTIVE}" = True ]; then
    NEW=$(whiptail --inputbox "Please enter a maximum retry count" 20 60 "${CURRENT}" 3>&1 1>&2 2>&3)
  else
    NEW="$1"
    true
  fi
  if [ $? -eq 0 ]; then
    case "${NEW}" in
      ''|*[!0-9]*)
        if [ "${INTERACTIVE}" = True ]; then
          whiptail --msgbox "The maximum retry count must be a number." 20 60 1
        fi
        return 1
        ;;
    esac
    set_config_var MAX_RETRY "${NEW}" "${CONFIG}"
    if [ -n "${NEW}" ] && [ "${INTERACTIVE}" = True ]; then
      whiptail --msgbox "The maximum retry count is ${NEW}" 20 60 1
    fi
  fi
}

do_select_iftype() {
  if [ "${INTERACTIVE}" = True ]; then
    TYPE=$(whiptail --menu "Choose the interface type for measurement" 20 60 10 \
      "1" "Wi-Fi" \
      "2" "Ethernet" \
      "3" "WWAN (cellular)" \
      3>&1 1>&2 2>&3)
    RET=$?
  else
    TYPE=$1
    RET=0
  fi
  if [ "${RET}" -eq 1 ]; then
    return 0
  elif [ "${RET}" -eq 0 ]; then
    if [ "${TYPE}" -eq 1 ]; then
      set_config_var IFTYPE Wi-Fi ${CONFIG}
      STATUS=Wi-Fi
    elif [ "${TYPE}" -eq 2 ]; then
      set_config_var IFTYPE Ethernet "${CONFIG}"
      STATUS=Ethernet
    elif [ "${TYPE}" -eq 3 ]; then
      set_config_var IFTYPE WWAN "${CONFIG}"
      STATUS=WWAN
    fi
  fi
  if [ "${INTERACTIVE}" = True ]; then
    whiptail --msgbox "The setting of interface type for measurement is ${STATUS}" 20 60 1
  fi
}

do_set_devname() {
  CURRENT=$(get_config_var DEVNAME "${CONFIG}")
  if [ "${INTERACTIVE}" = True ]; then
    NEW=$(whiptail --inputbox "Please enter a device name for measurement (e.g. wlan0/ra0/eth0)" 20 60 "${CURRENT}" 3>&1 1>&2 2>&3)
  else
    NEW="$1"
    true
  fi
  if [ $? -eq 0 ]; then
    if [ -z "${NEW}" ]; then
      if [ "${INTERACTIVE}" = True ]; then
        whiptail --msgbox "The device name must not be empty." 20 60 1
      fi
      return 1
    fi
    set_config_var DEVNAME "${NEW}" "${CONFIG}"
    if [ -n "${NEW}" ] && [ "${INTERACTIVE}" = True ]; then
      whiptail --msgbox "The device name of interface is ${NEW}" 20 60 1
    fi
  fi
}

do_iface_menu() {
  FUN=$(whiptail --title "SINDAN Configuration Tool" \
    --menu "Interface Settings" "$WT_HEIGHT" "$WT_WIDTH" "$WT_MENU_HEIGHT" \
    --cancel-button Back --ok-button Select \
    "I1 Interface type: " "Choose interface type: Wi-Fi, Ethernet or WWAN" \
    "I2 Device name: " "Set up a device name of interface" \
    3>&1 1>&2 2>&3)
  RET=$?
  if [ "${RET}" -eq 1 ]; then
    return 0
  elif [ "${RET}" -eq 0 ]; then
    case "$FUN" in
      I1\ *) do_select_iftype ;;
      I2\ *) do_set_devname ;;
      *) whiptail --msgbox "Programmer error: unrecognized option" 20 60 1 ;;
    esac || whiptail --msgbox "There was an error running option $FUN" 20 60 1
  fi
}

do_set_pingv4() {
  CURRENT_STR=$(get_config_var PING4_SRVS "${CONFIG}")
  CURRENT="$(echo "${CURRENT_STR}" | sed 's/"//g')"
  if [ "${INTERACTIVE}" = True ]; then
    NEW=$(whiptail --inputbox "Please enter target server's IP addresses (e.g. <target1>,<target2>)" 20 60 "${CURRENT}" 3>&1 1>&2 2>&3)
  else
    NEW="$1"
    true
  fi
  if [ $? -eq 0 ]; then
    STRING="\"${NEW}\""
    set_config_var PING4_SRVS "${STRING}" "${CONFIG}"
    if [ -n "${NEW}" ] && [ "${INTERACTIVE}" = True ]; then
      whiptail --msgbox "The target server's IP addresses are ${NEW}" 20 60 1
    fi
  fi
}

